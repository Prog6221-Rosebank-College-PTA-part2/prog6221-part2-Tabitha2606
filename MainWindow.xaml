        xmlns:local="clr-namespace:ST10483814_POE_PART_2"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Cybersecurity Awareness Bot" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">


