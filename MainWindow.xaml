                </TextBlock>

                <!--Chatbot Title-->
                <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FF00FF"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,2"/>


                <TextBlock Text="Protecting South African Citizens 🔒"
                           FontFamily="Consolas"
                           FontSize="10"
                           Foreground="#00CCCC"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

        <!--Chat History Section-->
        <Border Grid.Row="1"
                Background="#0F0F1A"
                Margin="10,10,10,5">

            <ScrollViewer x:Name="scrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="5">

                <!--Chat history will be displayed in this area-->
                <RichTextBox x:Name="chatHistorySection"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="White"
                             Padding="10"
                             VerticalScrollBarVisibility="Disabled"/>

            </ScrollViewer>
        </Border>

        <!--User Input Section-->
        <Border Grid.Row="2"
                Background="#0A0A14"
                BorderBrush="#00FFFF"
                BorderThickness="0,2,0,0"
                Padding="10">


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBox x:Name="txtUserInput"
                         Grid.Column="0"
                         Background="#1E1E32"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#00FFFF"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="11"
                         Padding="10,8"
                         Margin="0,0,10,0"
                         KeyDown="txtUserInput_KeyDown"
                         TextChanged="txtUserInput_TextChanged"
                         VerticalContentAlignment="Center"/>

                
               <TextBlock x:Name="txtPlaceholder"
                          Text="Type your message here..."
                          Margin="5,7,0,0"
                          Foreground="#FF808080"
                          IsHitTestVisible="False"/>


                <Button x:Name="btnClear"
                        Grid.Column="2"
                        Content="Clear"
                        Background="#3A1A1A"
                        Foreground="#FF4444"
                        BorderBrush="#FF4444"
                        BorderThickness="1"
                        FontFamily="Consolas"
                        FontSize="11"
                        Padding="15,8"
                        Cursor="Hand"
                        Click="btnClear_Click"/>

                <!--A send button that the user clicks for sending messages-->
                <Button x:Name="btnSend"
                        Grid.Column="1"
                        Content="Send"
                        Background="#00FFFF"
                        Foreground="#0A0A14"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Padding="20,8"
                        Cursor="Hand"
                        Click="btnSend_Click"/>

            </Grid>
        </Border>
    
</Grid>
</Window>   

