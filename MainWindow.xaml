                BorderBrush="#00FFFF"
                BorderThickness="0,0,0,2"
                Padding="15">
            <StackPanel>

                <TextBlock FontFamily="Consolas"
                       FontSize="8"
                       Foreground="#00FFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,5,0,5"
                       xml:space="preserve" Height="148" Width="497">

